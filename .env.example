APP_NAME=With You - Plataforma Resiliente
APP_ENV=development
DATABASE_URL=postgresql+psycopg://withyou:CHANGE_ME_DB@db:5432/withyou
POSTGRES_DB=withyou
POSTGRES_USER=withyou
POSTGRES_PASSWORD=CHANGE_ME_DB
TOKEN_SECRET=CHANGE_ME_WITH_32_PLUS_RANDOM_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
ALLOW_TEST_ENDPOINTS=true
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CHECKPOINT_TTL_HOURS=24
INCIDENT_HOLD_HOURS=72
LOCATION_GRANT_MINUTES=60
SAFETY_CHECK_TIMEOUT_SECONDS=300
WELFARE_CHECK_TTL_HOURS=2
CLEANUP_INTERVAL_SECONDS=60
COMMUNITY_CONFIRMATION_THRESHOLD=2
EARTHQUAKE_MIN_MAGNITUDE=4.5
EARTHQUAKE_MAX_DISTANCE_KM=150
EARTHQUAKE_MAX_AGE_MINUTES=30
SGC_QUERY_URL=https://srvags.sgc.gov.co/arcgis/rest/services/catalogo_sismos/catalogo_de_sismos_2/MapServer/0/query
SIRDEC_SODA_URL=https://www.datos.gov.co/resource/8hqm-7fdt.json
SIRDEC_PUBLIC_PORTAL_URL=https://siclico.medicinalegal.gov.co/consultasPublicas/Desaparecidos.xhtml
SIRDEC_DATASET_CUTOFF=junio de 2026
IDEAM_JSON_URL=
UNGRD_PORTAL_URL=https://portal.gestiondelriesgo.gov.co/
REDIS_URL=redis://redis:6379/0
CELERY_ENABLED=true
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
AUTO_CREATE_SCHEMA=true

SGC_POLL_ENABLED=true
SGC_POLL_INTERVAL_SECONDS=30
SGC_RETRY_ATTEMPTS=3
# Solo una réplica oficial verificada del mismo catálogo; vacío conserva último estado.
SGC_FALLBACK_QUERY_URL=

EARTHQUAKE_CHECKPOINT_MAX_AGE_MINUTES=60
SGC_TIME_FIELD=ESP_FECHA

SGC_SOURCE=biweekly
