@startuml
left to right direction
skinparam componentStyle rectangle
actor "Usuario / Contacto" as U
node "Teléfono Android\nFlutter" as M
node "PC de laboratorio" {
  component "FastAPI\nAPI REST" as API
  database "PostgreSQL + PostGIS" as DB
  component "Scheduler TTL\nbackground task" as JOB
}
cloud "SGC ArcGIS" as SGC
cloud "Datos Abiertos\nSIRDEC/SODA" as SIR
cloud "SICLICO\nconsulta humana" as SIC
U --> M
M --> API : HTTPS/LAN
API --> DB
API --> JOB
API --> SGC : sync configurable
API --> SIR : read-only
M --> SIC : abrir navegador
@enduml
